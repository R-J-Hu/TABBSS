; ─────────────────────────────────────────────────────────────
; 档案库报站模拟器 — NSIS Installer Template
; Generated by scripts/build_release.py at build time.
; Placeholders {{LIKE_THIS}} are replaced by the build script.
; ─────────────────────────────────────────────────────────────

!include "MUI2.nsh"
!include "FileFunc.nsh"

; ── Metadata ──────────────────────────────────────────────
Name "{{APP_NAME}}"
OutFile "{{INSTALLER_OUTPUT}}"
InstallDir "{{DEFAULT_INSTALL_DIR}}"
RequestExecutionLevel admin

!define APP_EXE "{{APP_EXE}}"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\TABBSS_{{EDITION_ID}}"

; ── Modern UI Settings ────────────────────────────────────
!define MUI_ABORTWARNING
!define MUI_ICON "{{ROOT_DIR}}\icon\TABBSS.ico"
!define MUI_UNICON "{{ROOT_DIR}}\icon\TABBSS.ico"

; Pages
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "{{LICENSE_PATH}}"
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_COMPONENTS
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "SimpChinese"

; ── Globals ───────────────────────────────────────────────
Var UpgradeMode

; ── .onInit: detect upgrade vs fresh install ──────────────
Function .onInit
  StrCpy $UpgradeMode "0"

  ; Check if already installed via registry
  ReadRegStr $0 HKLM "${UNINSTALL_KEY}" "UninstallString"
  ${If} $0 == ""
    Return
  ${EndIf}

  ; Check if APP_EXE is running
  nsExec::ExecToStack 'tasklist /FI "IMAGENAME eq ${APP_EXE}" /NH'
  Pop $1
  Pop $2
  ${If} $2 != ""
    StrCpy $1 $2 3
    ${If} $1 == "INFO"
      StrCpy $UpgradeMode "1"
      Return
    ${EndIf}
  ${EndIf}

  ; Process IS running — ask user
  MessageBox MB_YESNO|MB_ICONQUESTION \
    "检测到 档案库报站模拟器 正在运行。$\n$\n是否关闭程序并继续安装？$\n(线路数据不会被覆盖)" \
    IDYES kill IDNO abort
  kill:
    nsExec::ExecToStack 'taskkill /F /IM ${APP_EXE}'
    Sleep 2000
    StrCpy $UpgradeMode "1"
    Return
  abort:
    Quit
FunctionEnd


; ── Installer Sections ────────────────────────────────────

Section "!档案库报站模拟器 (必需)" SecMain
  SectionIn RO
  SetOutPath "$INSTDIR"

  ; Main executable (always installed)
  File "{{BUILD_DIR}}\{{APP_EXE}}"

  ; Data directories — only on fresh install
  ${If} $UpgradeMode == "0"
    SetOutPath "$INSTDIR\报站线路文件库"
    File /nonfatal /r "{{BUILD_DIR}}\报站线路文件库\*"

    SetOutPath "$INSTDIR\兼容模式-海峡报站器文件库"
    File /nonfatal /r "{{BUILD_DIR}}\兼容模式-海峡报站器文件库\*"

    SetOutPath "$INSTDIR\output"
    File /nonfatal /r "{{BUILD_DIR}}\output\*"
  ${EndIf}

  ; Grant write permission on data dirs (Program Files is read-only)
  nsExec::ExecToStack 'icacls "$INSTDIR\报站线路文件库" /grant "*S-1-5-32-545:(OI)(CI)M" /T /Q'
  Pop $0
  nsExec::ExecToStack 'icacls "$INSTDIR\兼容模式-海峡报站器文件库" /grant "*S-1-5-32-545:(OI)(CI)M" /T /Q'
  Pop $0
  nsExec::ExecToStack 'icacls "$INSTDIR\output" /grant "*S-1-5-32-545:(OI)(CI)M" /T /Q'
  Pop $0

  ; Write uninstaller
  WriteUninstaller "$INSTDIR\Uninstall.exe"

  ; Register in Add/Remove Programs
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayName" "{{APP_NAME}}"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayIcon" '"$INSTDIR\${APP_EXE}"'
  WriteRegStr HKLM "${UNINSTALL_KEY}" "Publisher" "{{PUBLISHER}}"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayVersion" "{{VERSION}}"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "URLInfoAbout" "{{APP_URL}}"
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "EstimatedSize" "$0"
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoRepair" 1

  ; Start Menu shortcuts
  CreateDirectory "$SMPROGRAMS\{{START_MENU_GROUP}}"
  CreateShortcut "$SMPROGRAMS\{{START_MENU_GROUP}}\{{APP_NAME}}.lnk" \
    "$INSTDIR\${APP_EXE}" "" "$INSTDIR\${APP_EXE}" 0
  CreateShortcut "$SMPROGRAMS\{{START_MENU_GROUP}}\卸载 {{APP_NAME}}.lnk" \
    "$INSTDIR\Uninstall.exe"

  ; ── File association: .tabl ────────────────────────────────
  ; Install the icon file
  SetOutPath "$INSTDIR\icon"
  File /nonfatal "{{TABL_ICON_PATH}}"

  ; Register .tabl extension
  WriteRegStr HKLM "Software\Classes\.tabl" "" "TABBSS.tabl"
  WriteRegStr HKLM "Software\Classes\.tabl" "Content Type" "application/x-tabbss-route"
  WriteRegStr HKLM "Software\Classes\TABBSS.tabl" "" "档案库报站器线路文件"
  WriteRegStr HKLM "Software\Classes\TABBSS.tabl\DefaultIcon" "" "$INSTDIR\icon\tabl_icon.ico"
  WriteRegStr HKLM "Software\Classes\TABBSS.tabl\shell\open\command" "" '"$INSTDIR\${APP_EXE}" "--open-tabl" "%1"'
  ; Notify shell of change
  ${RefreshShellIcons}
SectionEnd


Section "桌面快捷方式" SecDesktop
  CreateShortcut "$DESKTOP\{{APP_NAME}}.lnk" \
    "$INSTDIR\${APP_EXE}" "" "$INSTDIR\${APP_EXE}" 0
SectionEnd


Section "WebView2 运行时 (推荐安装，页面正常显示所需)" SecWebView2
  SetOutPath "$INSTDIR"
  File /nonfatal "{{WEBVIEW2_BOOTSTRAPPER}}"
  ExecWait '"$INSTDIR\MicrosoftEdgeWebView2RuntimeInstallerX64.exe" /silent /install'
  Delete "$INSTDIR\MicrosoftEdgeWebView2RuntimeInstallerX64.exe"
SectionEnd


Section /o "FFmpeg (音频转换支持, ~680MB)" SecFFmpeg
  SetOutPath "$INSTDIR\_ffmpeg"
  File /nonfatal /r "{{BUILD_DIR}}\_ffmpeg\*"
SectionEnd


; ── Uninstaller Sections ──────────────────────────────────

Section "un.程序文件" UnSecProgram
  nsExec::ExecToStack 'taskkill /F /IM ${APP_EXE}'
  Pop $0

  Delete "$INSTDIR\${APP_EXE}"
  Delete "$INSTDIR\Uninstall.exe"
  Delete "$INSTDIR\icon\tabl_icon.ico"
  RMDir "$INSTDIR\icon"
  RMDir /r "$INSTDIR\_ffmpeg"
  RMDir /r "$SMPROGRAMS\{{START_MENU_GROUP}}"
  Delete "$DESKTOP\{{APP_NAME}}.lnk"
  DeleteRegKey HKLM "${UNINSTALL_KEY}"
  ; Remove file association
  DeleteRegKey HKLM "Software\Classes\TABBSS.tabl"
  DeleteRegValue HKLM "Software\Classes\.tabl" ""
  DeleteRegValue HKLM "Software\Classes\.tabl" "Content Type"
  RMDir "$INSTDIR"
SectionEnd


Section /o "un.用户数据 (报站线路文件库和兼容模式)" UnSecData
  RMDir /r "$INSTDIR\报站线路文件库"
  RMDir /r "$INSTDIR\兼容模式-海峡报站器文件库"
  RMDir /r "$INSTDIR\output"
  RMDir "$INSTDIR"
SectionEnd


; ── Section descriptions ──────────────────────────────────
LangString DESC_SecMain ${LANG_SIMPCHINESE} "档案库报站模拟器主程序及线路数据。升级安装时不会覆盖已有线路数据。"
LangString DESC_SecDesktop ${LANG_SIMPCHINESE} "在桌面创建快捷方式。"
LangString DESC_SecWebView2 ${LANG_SIMPCHINESE} "Microsoft Edge WebView2 运行时，用于页面正常显示。如系统已安装则自动跳过。"
LangString DESC_SecFFmpeg ${LANG_SIMPCHINESE} "FFmpeg 用于音频格式转换。如不需要可取消勾选以节省空间。"

LangString DESC_UnSecProgram ${LANG_SIMPCHINESE} "删除程序文件及快捷方式。用户数据默认保留。"
LangString DESC_UnSecData ${LANG_SIMPCHINESE} "同时删除所有线路数据和音频文件（谨慎操作）。"

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SecMain} $(DESC_SecMain)
  !insertmacro MUI_DESCRIPTION_TEXT ${SecDesktop} $(DESC_SecDesktop)
  !insertmacro MUI_DESCRIPTION_TEXT ${SecWebView2} $(DESC_SecWebView2)
  !insertmacro MUI_DESCRIPTION_TEXT ${SecFFmpeg} $(DESC_SecFFmpeg)
!insertmacro MUI_FUNCTION_DESCRIPTION_END

!insertmacro MUI_UNFUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${UnSecProgram} $(DESC_UnSecProgram)
  !insertmacro MUI_DESCRIPTION_TEXT ${UnSecData} $(DESC_UnSecData)
!insertmacro MUI_UNFUNCTION_DESCRIPTION_END
